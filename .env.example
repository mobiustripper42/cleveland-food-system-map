# Server-only. Postgres connection (Supabase > Connect: transaction pooler on Vercel,
# session pooler for drizzle-kit). Used by the app, BetterAuth, and scripts.
DATABASE_URL=

# BetterAuth. Secret: `openssl rand -base64 32`. URL: the site origin, e.g.
# http://localhost:3000 locally, https://clevelandfoodsystem.land in production.
# Its hostname is also the passkey relying-party ID — passkeys made on one
# host don't work on another.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# OAuth apps. Callback URLs: <BETTER_AUTH_URL>/api/auth/callback/google and .../facebook
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Sign-in / verification / reset codes, sent with Resend (https://resend.com).
# EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="onboarding@resend.dev"

# Public base URL for location photos, no trailing slash. Today:
# https://<project>.supabase.co/storage/v1/object/public/location-images
LOCATION_IMAGES_BASE_URL=
