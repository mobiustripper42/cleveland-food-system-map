# Server-only. Postgres connection (Supabase > Connect: transaction pooler on Vercel,
# session pooler for drizzle-kit). Used by the app, BetterAuth, and scripts.
DATABASE_URL=

# BetterAuth. Secret: `openssl rand -base64 32`. URL: the site origin, e.g.
# http://localhost:3000 locally, https://clevelandfoodsystem.land in production.
# Its hostname is also the passkey relying-party ID — passkeys made on one
# host don't work on another.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# OAuth apps. Callback URLs: <BETTER_AUTH_URL>/api/auth/callback/google and .../facebook
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Sign-in / verification / reset codes, sent with Resend (https://resend.com).
# EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="onboarding@resend.dev"

# Cloudflare R2 for location files (lib/r2.ts). API token: Object Read & Write,
# scoped to the bucket. The bucket needs a CORS rule allowing PUT + GET with
# the content-type and cache-control headers from the site origin(s).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=food-system-map
# Public read URL, no trailing slash: the bucket's r2.dev URL for now
# (https://pub-<hash>.r2.dev), a custom domain later.
R2_PUBLIC_BASE_URL=
